---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main>
    <section class="hero">
      <p class="eyebrow">E-BOOK</p>
      <h1>Tajemnica Światła</h1>
      <p class="subtitle">
        Odkryj historię, która zaprasza do spojrzenia
        na świat z innej perspektywy.
      </p>
      <a
        class="button"
        href="https://store.reddfy.pl/b/bz1AI"
      >
        Odkryj e-book
      </a>
    </section>
  </main>
</Layout>

<style>
  :global(body) {
    margin: 0;
    background: #101827;
    color: #ffffff;
    font-family: Arial, sans-serif;
  }

  .hero {
    min-height: 90vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 40px 20px;
    box-sizing: border-box;
  }

  .eyebrow {
    color: #d9b96e;
    letter-spacing: 4px;
    font-size: 14px;
  }

  h1 {
    font-size: clamp(42px, 7vw, 80px);
    margin: 20px 0;
    color: #f0d58a;
  }

  .subtitle {
    max-width: 620px;
    font-size: 20px;
    line-height: 1.7;
    color: #d5dbe5;
  }

  .button {
    display: inline-block;
    margin-top: 30px;
    padding: 16px 32px;
    background: #d9b96e;
    color: #101827;
    text-decoration: none;
    font-weight: bold;
    border-radius: 8px;
  }

  .button:hover {
    background: #f0d58a;
  }
</style>
